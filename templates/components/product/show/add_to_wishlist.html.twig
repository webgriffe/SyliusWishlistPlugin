{# Rendered with \BitBag\SyliusWishlistPlugin\Twig\Component\Product\AddToWishlistComponent #}

{% set product = variant.product %}

<div class="mb-3" {{ attributes }}>
    <button
        type="button"
        class="btn btn-icon btn-outline-secondary"
        data-product-name="{{ product.name }}"
        data-action="live#action:prevent live#$render"
        data-live-action-param="addToWishlist"
        {{ sylius_test_html_attribute('wishlist-add-product') }}
    >
        {{ ux_icon('mdi:heart', {'class': 'icon icon-sm'}) }}
        {{ 'bitbag_sylius_wishlist_plugin.ui.add_to_wishlist'|trans }}
    </button>
</div>
