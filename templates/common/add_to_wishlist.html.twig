{# Rendered with \BitBag\SyliusWishlistPlugin\Twig\Component\Product\AddToWishlistComponent #}

{% set product = hookable_metadata.context.product %}

<div class="my-3">
    <a
            href="{{ path('bitbag_sylius_wishlist_plugin_shop_wishlist_add_product', {'productId': product.id}) }}"
            class="btn btn-icon btn-outline-secondary w-100"
            data-product-name="{{ product.name }}"
            {{ sylius_test_html_attribute('wishlist-add-product') }}
    >
        {{ ux_icon('mdi:heart', {'class': 'icon icon-sm'}) }}
        {{ 'bitbag_sylius_wishlist_plugin.ui.add_to_wishlist'|trans }}
    </a>
</div>
